{
  "manifest_version": 3,
  "name": "ChatManager",
  "version": "1.0",
  "description": "Revamp your AI use experience",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "*://gemini.google.com/app/*"
  ],
  "icons": {
    "16": "icons/icons-16.png",
    "48": "icons/icons-48.png",
    "128": "icons/icons-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/app/*"],
      "js": ["content/utils/logger.js", "content/utils/initial.js", "content/content-gemini.js"],
      "css": ["content/content.css"]
    }
  ]
}
